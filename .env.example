# Copy to .env.local for local development (never commit real values).
#   macOS:   cp .env.example .env.local
#   Windows: copy .env.example .env.local
# Keep this file up to date whenever code reads a new environment variable.

# Public URL of the site (used for SEO metadata, sitemap and robots.txt).
# Production: https://mosherblox.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to keep /design-kit available in a production build (it 404s there by default).
# DESIGN_KIT=1

# PostgreSQL. Local: `npm run db:up` starts it in Docker on port 5433 (docker-compose.yml).
DATABASE_URL=postgres://mosherblox:mosherblox@localhost:5433/mosherblox

# Where uploaded payment screenshots are stored (outside public/). Default: ./storage/uploads
# UPLOAD_DIR=storage/uploads

# Discord webhook (Server Settings → Integrations → Webhooks) for team pings when a buyer presses
# "Saya sudah bayar". Secret: anyone with this URL can post in the channel. Leave empty to disable.
DISCORD_WEBHOOK_URL=
# Set to 1 to also get a ping for every new (unpaid) order.
# DISCORD_NOTIFY_NEW_ORDERS=1
