# Copy to .env.local for local development (never commit real values).
#   macOS:   cp .env.example .env.local
#   Windows: copy .env.example .env.local
# Keep this file up to date whenever code reads a new environment variable.

# Public URL of the site (used for SEO metadata, sitemap and robots.txt).
# Production: https://mosherblox.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 to keep /design-kit available in a production build (it 404s there by default).
# DESIGN_KIT=1

