{
  "name": "mosherblox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run build",
    "tokens": "node scripts/export-tokens.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/seed-dev.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "worker": "tsx --conditions=react-server src/worker/index.mts",
    "worker:dev": "tsx watch --conditions=react-server src/worker/index.mts",
    "worker:build": "esbuild src/worker/index.mts --bundle --platform=node --format=esm --target=node22 --conditions=react-server --packages=external --outfile=dist/worker.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "next": "16.4.6",
    "pg-boss": "12.38.1",
    "postgres": "4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "description": "MOSHERBLOX — game top-up store (frontend, phase 1)",
  "engines": {
    "node": ">=20.9.0"
  }
}
