{
	servers {
		# Cloudflare's addresses (https://www.cloudflare.com/ips/): only they may tell us the visitor's
		# IP. Works with the grey cloud (direct visitors) and the orange cloud (proxied).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/222400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

www.mosherblox.com {
	redir https://mosherblox.com{uri} permanent
}

mosherblox.com {
	encode zstd gzip
	request_body {
		# 4 MB screenshots + form overhead (next.config.ts allows 5 MB).
		max_size 6MB
	}
	reverse_proxy app:3000 {
		# The app's rate limits read X-Forwarded-For: always overwrite it, so it can't be faked.
		header_up X-Forwarded-For {client_ip}
		header_up -CF-Connecting-IP
		# Wait while the app restarts during a deploy instead of showing an error.
		lb_try_duration 20s
	}
}
